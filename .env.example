# AegisThread — root compose stack environment template.
#
# Copy to `.env` (git-ignored) and adjust. compose.yaml interpolates these
# values for the `postgres` service; without a .env file the inline defaults
# below apply. Dev-only values — Pass E documents production handling.
#
# CONSTRAINT: POSTGRES_PASSWORD must not contain characters that break
# compose interpolation (`$`, backtick) or URL parsing (`:`, `/`, `@`, `?`,
# `#`, `[`, `]`, `%`) — it is embedded in DATABASE_URL strings by consumers.

# Database name created on first boot (named volume persists it).
POSTGRES_DB=aegisthread

# Superuser created on first boot. Changing these AFTER first boot has no
# effect on an existing volume (re-create with `docker compose down -v`).
POSTGRES_USER=aegisthread

# Dev-only password. NEVER reuse outside the local stack.
POSTGRES_PASSWORD=aegisthread
