# Base URL the Next.js SERVER process uses to reach the backend API
# (server-side fetch in app/page.tsx; in the compose stack the container env
# sets this to http://backend:8080).
# Server-only: NEVER prefix with NEXT_PUBLIC_ — the value must not leak into
# the client bundle.
# If unset, the code falls back to http://localhost:8081 — the backend's
# published HOST port (the container-internal port is 8080; see root
# compose.yaml).
BACKEND_BASE_URL=http://localhost:8081
