{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "git add*": "ask",
      "git rm*": "ask",
      "git mv*": "ask",
      "git commit*": "ask",
      "git merge*": "ask",
      "git rebase*": "ask",
      "git revert*": "ask",
      "git reset*": "ask",
      "git restore*": "ask",
      "git checkout*": "ask",
      "git stash drop*": "ask",
      "git stash clear*": "ask",
      "git tag*": "ask",
      "git push*": "ask",
      "git clean*": "deny",
      "git reset --hard*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny"
    },
    "external_directory": "ask"
  }
}
