# AegisThread backend — environment template.
#
# Copy to `.env` (or `.env.local` for local overrides) and adjust.
# `.env` is git-ignored on purpose: real values are environment-specific and
# production values are documented in Pass E (deployment), not here.

# Application environment: dev | test | prod
APP_ENV=dev

# Debug mode — explicit on purpose: Symfony's runtime silently defaults it
# to enabled outside prod. Deliberate loopback-only dev choice (the stack
# binds 127.0.0.1); set APP_DEBUG=0 for any non-loopback exposure.
APP_DEBUG=1

# Dev-only placeholder — MUST be replaced with a generated secret in every
# real environment (e.g. `php -r 'echo bin2hex(random_bytes(16));'`).
APP_SECRET=dev_only_not_a_secret_change_me

# PostgreSQL (the source of truth, per ADR-0002).
# Placeholder credentials for the local Docker stack (root compose.yaml wires
# the `postgres` service); replace user/password/host for real environments.
# NOTE: the DSN deliberately carries NO serverVersion parameter —
# config/packages/doctrine.yaml pins `server_version`, so DBAL never probes
# the platform version from the connection (a bare DSN would otherwise fail
# with `Invalid platform version ""`).
DATABASE_URL="pdo-pgsql://aegisthread:aegisthread@postgres:5432/aegisthread?connect_timeout=2&charset=utf8"

# Base URI used for URL generation in non-HTTP (CLI) contexts.
DEFAULT_URI=http://localhost:8080
