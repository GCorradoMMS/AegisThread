# PHPStan configuration for the AegisThread backend.
#
# The symfony extension reads the compiled dev container, so run this first
# (inside the container, from /app):
#
#     php bin/console cache:warmup --env=dev
#
# If var/cache/dev/AegisThread_KernelDevDebugContainer.xml is missing,
# PHPStan reports a clear "File ... does not exist" error pointing at the
# containerXmlPath below.
includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: max
    paths:
        - src
        - tests
    excludePaths:
        # Generated by the symfony/phpunit-bridge recipe; its defensive
        # method_exists() API check is expected to be always-true here.
        - tests/bootstrap.php
    reportUnmatchedIgnoredErrors: true
    symfony:
        containerXmlPath: %currentWorkingDirectory%/var/cache/dev/AegisThread_KernelDevDebugContainer.xml
